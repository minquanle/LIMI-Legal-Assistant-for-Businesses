# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tinix_legal?schema=public"

# Meilisearch configuration
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="masterKey123!"

# MinIO configuration (Object Storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="password123"
MINIO_BUCKET="legal-documents"

# API Server configuration
API_PORT="4001"
API_HOST="0.0.0.0"

# Q&A LLM Generation (no default — must be set explicitly, do not commit real values)
QA_LLM_API_URL=""
QA_LLM_API_KEY=""
QA_LLM_MODEL="tinix-combo-1"

# Admin authentication (required in every environment; server refuses admin
# requests if unset — see packages/backend/src/middleware/auth-guard.ts).
#
# SERVER-ONLY. Never mirror this into a NEXT_PUBLIC_* variable: Next.js inlines
# those into the client bundle, which would hand the key to every visitor. The
# admin UI signs in at /admin, and calls are proxied through
# packages/frontend/src/app/api/admin-proxy — the secret stays on the server.
ADMIN_SECRET_KEY=""
# Backend origin used by the frontend's server-side admin proxy. Defaults to
# NEXT_PUBLIC_API_URL when unset.
BACKEND_API_URL=""
# Comma-separated list of extra origins allowed by backend CORS
ALLOWED_ORIGINS=""
NODE_ENV="development"
