{
  "name": "@tinix-legal/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Vietnam Legal Document Search System",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:mvp": "npm -w @tinix-legal/shared run build && npm -w @limi/compliance-core run build && prisma generate && tsc -p tsconfig.mvp.json",
    "db:mvp:deploy": "tsx scripts/migrate-mvp.ts",
    "test:mvp:db": "tsx scripts/verify-b2-database.ts",
    "import:mvp": "tsx scripts/import-curated-laws.ts",
    "test:mvp:legal": "tsx scripts/verify-b3-b4.ts",
    "test:mvp:import": "tsx scripts/verify-import-recovery.ts",
    "start:mvp": "node dist-mvp/mvp-api.js",
    "dev:mvp": "tsx watch src/mvp-api.ts",
    "worker:mvp": "node dist-mvp/mvp-worker.js",
    "scheduler:mvp": "node dist-mvp/mvp-scheduler.js",
    "storage:mvp:init": "tsx scripts/init-mvp-storage.ts",
    "test:mvp": "vitest run --config vitest.mvp.config.ts",
    "smoke:mvp": "tsx scripts/smoke-mvp.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "script:ingest-hf": "tsx scripts/ingest-huggingface.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/db/seed.ts",
    "script:llm-relations": "tsx scripts/llm-relations.ts",
    "test": "vitest run",
    "account:mvp": "tsx scripts/create-pilot-account.ts",
    "test:mvp:workspace": "tsx scripts/verify-workspace.ts",
    "test:mvp:compliance": "tsx scripts/verify-compliance.ts",
    "prepare:mvp:compliance": "tsx scripts/prepare-compliance.ts",
    "test:mvp:alerts": "tsx scripts/verify-alerts-changes.ts",
    "prepare:mvp:watchset": "tsx scripts/prepare-watchset.ts",
    "backup:mvp": "tsx scripts/backup-restore-mvp.ts backup",
    "restore:mvp:drill": "tsx scripts/backup-restore-mvp.ts restore-drill",
    "report:mvp:operations": "tsx scripts/report-operations.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@tinix-legal/shared": "*",
    "bullmq": "^5.79.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.0",
    "duckdb": "^1.4.4",
    "express": "^4.21.0",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.44.0",
    "minio": "^8.0.7",
    "node-cron": "^3.0.3",
    "parquetjs-lite": "^0.8.7",
    "stream-json": "1.9.1",
    "winston": "^3.14.0",
    "zod": "3.25.76",
    "@limi/compliance-core": "*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
