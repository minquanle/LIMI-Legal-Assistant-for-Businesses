  completedAt     DateTime?
  reminderDays    Int       @default(7) // Báo trước X ngày
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([milestoneType])
  @@index([dueDate])
  @@index([isCompleted])
