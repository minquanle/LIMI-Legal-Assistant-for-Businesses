}

model ImportedDocumentIdentity {
  id String @id @default(uuid()) @db.Uuid
  datasetKey String
  externalId String
  documentId String
  document CanonicalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([datasetKey, externalId], name: "imported_identity")
  @@index([documentId])
  @@map("imported_document_identities")
}

model DocumentSnapshot {
  id String @id @default(uuid()) @db.Uuid
  documentId String
  document CanonicalDocument @relation("DocumentSnapshots", fields: [documentId], references: [id], onDelete: Restrict)
  selectedBy CanonicalDocument[] @relation("SelectedSnapshot")
  contentHash String @db.Char(64)
  metadataHash String @db.Char(64)
  metadataJson Json
  fullText String @db.Text
  qualityJson Json @default("{}")
  correctionsJson Json @default("{}")
  parsedAt DateTime? @db.Timestamptz(6)
  observedAt DateTime? @db.Timestamptz(6)
  parserVersion String?
  reason SnapshotReason @default(INITIAL_IMPORT)
  rawRecordObjectKey String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sources SnapshotSource[]
  assets SnapshotAsset[]
  parseRuns ParseRun[]
  observations SourceObservation[]
  reviews LegalReviewDecision[]
  obligationCitations ObligationCitation[]
  importResults ImportRecordResult[]
  sourceRelations DocumentRelation[] @relation("RelationSourceSnapshot")
  targetRelations DocumentRelation[] @relation("RelationTargetSnapshot")
  @@unique([documentId, contentHash, metadataHash], name: "snapshot_version")
  @@unique([documentId, id])
  @@index([documentId, createdAt])
  @@map("document_snapshots")
}

model SnapshotSource {
  id String @id @default(uuid()) @db.Uuid
  documentId String
  snapshotId String @db.Uuid
  snapshot DocumentSnapshot @relation(fields: [documentId, snapshotId], references: [documentId, id], onDelete: Restrict)
  sourceId String
  source DocumentSource @relation(fields: [documentId, sourceId], references: [documentId, id], onDelete: Restrict)
  role SnapshotSourceRole
  provenanceHash String @db.Char(64)
  provenanceJson Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([snapshotId, sourceId, role, provenanceHash])
  @@index([sourceId])
  @@map("snapshot_sources")
}

model ParseRun {
  id String @id @default(uuid()) @db.Uuid
  snapshotId String @db.Uuid
  snapshot DocumentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  parserVersion String
  structureHash String @db.Char(64)
  structureJson Json
  qualityJson Json @default("{}")
  offsetUnit String @default("UNICODE_CODE_POINT")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sealedAt DateTime? @db.Timestamptz(6)
  provisions ParsedProvision[]
  reviews LegalReviewDecision[]
  obligationCitations ObligationCitation[]
  @@unique([snapshotId, parserVersion, structureHash], name: "parse_version")
  @@unique([snapshotId, id])
  @@map("parse_runs")
}

model ParsedProvision {
  id String @id @default(uuid()) @db.Uuid
  parseRunId String @db.Uuid
  parseRun ParseRun @relation(fields: [parseRunId], references: [id], onDelete: Restrict)
  externalNodeId String
  nodeType ASTNodeType
  ordinal String?
  heading String?
  spanStart Int
  spanEnd Int
  orderIndex Int
  depth Int
  contextJson Json @default("[]")
  quotedAmendmentCandidate Boolean @default(false)
  parentId String? @db.Uuid
  parent ParsedProvision? @relation("VersionProvisionTree", fields: [parseRunId, parentId], references: [parseRunId, id], onDelete: NoAction, onUpdate: NoAction)
  children ParsedProvision[] @relation("VersionProvisionTree")
  obligationCitations ObligationCitation[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([parseRunId, externalNodeId], name: "provision_external_id")
  @@unique([parseRunId, id])
  @@index([parseRunId, orderIndex])
  @@index([parentId])
  @@map("parsed_provisions")
}

model SourceObservation {
  id String @id @default(uuid()) @db.Uuid
  documentId String
  sourceId String
  source DocumentSource @relation(fields: [documentId, sourceId], references: [documentId, id], onDelete: Restrict)
  snapshotId String? @db.Uuid
  snapshot DocumentSnapshot? @relation(fields: [documentId, snapshotId], references: [documentId, id], onDelete: NoAction, onUpdate: NoAction)
  observedAt DateTime @default(now()) @db.Timestamptz(6)
  httpStatus Int?
  rawHash String? @db.Char(64)
  rawObjectKey String?
  etag String?
  lastModified String?
  result String
  provenanceJson Json @default("{}")
  @@index([sourceId, observedAt])
  @@map("source_observations")
}

model ObjectAsset {
  id String @id @default(uuid()) @db.Uuid
  bucket String
  objectKey String
  checksum String @db.Char(64)
  sizeBytes BigInt
  mimeType String
  status AssetStatus @default(PENDING)
  errorCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  snapshotLinks SnapshotAsset[]
  importFiles ImportFile[]
  @@unique([bucket, objectKey])
  @@index([checksum])
  @@map("object_assets")
}

model SnapshotAsset {
  id String @id @default(uuid()) @db.Uuid
  snapshotId String @db.Uuid
  snapshot DocumentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  assetId String @db.Uuid
  asset ObjectAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  role SnapshotAssetRole
  provenanceJson Json @default("{}")
  extractedText String? @db.Text
  extractedTextHash String? @db.Char(64)
  @@unique([snapshotId, assetId, role])
  @@map("snapshot_assets")
}

model ImportFile {
  id String @id @default(uuid()) @db.Uuid
  datasetKey String
  fileHash String @db.Char(64)
  format ImportFormat
  originalName String
  schemaVersion String?
  recordCount Int?
  assetId String? @db.Uuid
  asset ObjectAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  runs ImportRun[]
  @@unique([datasetKey, fileHash])
  @@map("import_files")
}

model ImportRun {
  id String @id @default(uuid()) @db.Uuid
  fileId String @db.Uuid
  file ImportFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  importerVersion String
  mode ImportMode @default(IMPORT)
  status ImportRunStatus @default(QUEUED)
  lastCommittedRecordIndex Int @default(-1)
  countersJson Json @default("{}")
  startedAt DateTime? @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  errorCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  results ImportRecordResult[]
  @@index([fileId, createdAt])
  @@map("import_runs")
}

model ImportRecordResult {
  id String @id @default(uuid()) @db.Uuid
  runId String @db.Uuid
  run ImportRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  recordIndex Int
  externalId String?
  recordHash String? @db.Char(64)
  outcome ImportOutcome
  documentId String?
  document CanonicalDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  snapshotId String? @db.Uuid
  snapshot DocumentSnapshot? @relation(fields: [documentId, snapshotId], references: [documentId, id], onDelete: NoAction, onUpdate: NoAction)
  errorCode String?
  provenanceJson Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([runId, recordIndex])
  @@index([externalId])
  @@map("import_record_results")
}

model LegalReviewDecision {
  id String @id @default(uuid()) @db.Uuid
  snapshotId String @db.Uuid
  snapshot DocumentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  parseRunId String? @db.Uuid
  parseRun ParseRun? @relation(fields: [snapshotId, parseRunId], references: [snapshotId, id], onDelete: NoAction, onUpdate: NoAction)
  kind LegalReviewKind
  verdict LegalReviewVerdict
  reviewerRef String
  asOfDate DateTime @db.Date
  evidenceJson Json
  notes String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([snapshotId, kind, createdAt])
  @@map("legal_review_decisions")
}

// Reviewer-managed settings for discovering new legal documents from official sources (single row).
model LawDiscoverySetting {
  id String @id @default("default")
  enabled Boolean @default(false)
  sources Json @default("[]")
  intervalHours Int @default(24)
  maxPerRun Int @default(20)
  effectiveFrom DateTime? @db.Date
  updatedBy String?
  lastRunAt DateTime?
  updatedAt DateTime @updatedAt
}
