# Copy to .limi.env; use init:mvp:env to generate unique local credentials.
NODE_ENV=development
LIMI_POSTGRES_USER=limi
LIMI_POSTGRES_PASSWORD=replace-with-generated-password
LIMI_POSTGRES_DB=limi_dev
DATABASE_URL=postgresql://limi:replace-with-generated-password@127.0.0.1:5433/limi_dev?schema=public&connect_timeout=3&socket_timeout=3
REDIS_URL=redis://127.0.0.1:6381/0
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=limi-local
MINIO_SECRET_KEY=replace-with-generated-secret
MINIO_BUCKET=limi-private
API_HOST=127.0.0.1
API_PORT=4010
WORKER_HEALTH_PORT=4011
SCHEDULER_HEALTH_PORT=4012
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000
HEALTH_TIMEOUT_MS=4000
